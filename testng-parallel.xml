<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Module 15 Parallel Regression" verbose="1" parallel="methods" thread-count="3">
    <listeners>
        <listener class-name="com.learning.tests.listeners.FrameworkTestListener"/>
        <listener class-name="com.learning.tests.listeners.RetryAnnotationTransformer"/>
    </listeners>
    <test name="SauceDemo Parallel Regression">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="com.learning.tests.saucedemo.SauceDemoPageObjectTest"/>
            <class name="com.learning.tests.saucedemo.SauceDemoDataDrivenTest"/>
        </classes>
    </test>
</suite>
